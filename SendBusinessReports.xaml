                                    </Assign.To>
                                    <Assign.Value>
                                      <InArgument x:TypeArguments="x:Object">[If(CurrentRow("Status").ToString() = "Submitted", "Submitted", "Review")]</InArgument>
                                    </Assign.Value>
                                  </Assign>
                                  <Assign DisplayName="MAIL - Keep First Group Error">
                                    <Assign.To>
                                      <OutArgument x:TypeArguments="s:Exception">[processException]</OutArgument>
                                    </Assign.To>
                                    <Assign.Value>
                                      <InArgument x:TypeArguments="s:Exception">[If(processException, New System.InvalidOperationException("Group dispatch failed; review the email state before retrying. Group=" &amp; CurrentRow("GroupName").ToString() &amp; " | Type=" &amp; exGroup.GetBaseException().GetType().FullName))]</InArgument>
                                    </Assign.Value>
                                  </Assign>
                                  <ui:LogMessage DisplayName="MAIL - Log Group Error" Level="Error" Message="[&quot;[BusinessMail] Group dispatch needs review | Group=&quot; &amp; CurrentRow(&quot;GroupName&quot;).ToString() &amp; &quot; | Type=&quot; &amp; exGroup.GetBaseException().GetType().FullName &amp; &quot; | HResult=&quot; &amp; exGroup.GetBaseException().HResult.ToString()]"/>
                                </Sequence>
                              </ActivityAction>
                            </Catch>
                          </TryCatch.Catches>
                          <TryCatch.Finally>
                            <If DisplayName="MAIL - Release Reservation Handle" Condition="[claimStream IsNot Nothing]">
                              <If.Then>
